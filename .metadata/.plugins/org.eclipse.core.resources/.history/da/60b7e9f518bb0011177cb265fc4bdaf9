package com.hexagon.galleryapp.controller.gallery;

import java.io.FileInputStream;
import java.io.IOException;
import java.io.OutputStream;

import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

/*
 * 브라우저가 톰켓에게 정적자원(html, css, image 등)을 요청하면 개발자가 정의해놓은 서블릿이 관여할 필요도 없이
 * 톰켓 스스로가 해당 정적자원을 읽어들여  응답정보로 보내버린다..
 *  ex)   브라우저가  http://localhost:8888/gallery/a.png 와 같은 정적 자원을 요청하면  Tomcat 이 해당 이미지를 응답 정보로 보내준다..

 하지만, 우리의 경우 Tomcat 이  upload 디렉토리를 보유하고 있지 않으므로, 자동으로 이미지를 보내주는 기능은 없다!!!
 해결책?)   서블릿 java 이므로 ,  tomcat 외부의  os 차원의 디렉토리를 접근할 수 있다..따라서 서블릿에서 해당 이미지를 스트림으로 읽어들여 
                응답 정보에 담아두면,  Tomcat 이 평소처럼 웹브라우저에 해당 이미지 정보를 보내준다.. 
 * */
@WebServlet("/image/*")  //    예) localhost:8888/image/a.png, localhost:8888/image/b.png
public class ImageServlet extends HttpServlet{

	protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		
		// 웹브라우저에서 요청한 자원 알아맞추기!! ex) localhost:8888/test.png   <-- test.png 를 알아맞추기 
		String filename = request.getPathInfo();
		System.out.println("브라우저에서 요청한 정적 자원의 이름은 "+filename);
		
		//외부 디렉토리에 접근하여 이미지를 읽어들여보자!!
		//파일을 대상으로 한 입력 스트림
		
		//고양이가 응답 정보로 보낼 컨텐츠는 ,오늘은  html 이  아니라 우리가 읽어들인 이미지이다!!
		response.setContentType();
		try(FileInputStream fis=new FileInputStream("C:/Users/user/upload"+filename)){
			
			//고양이가  response 객체에 들어있는 출력스트림을 이용하여 컨텐츠를 응답정보로 만들기 때문에...
			OutputStream os=response.getOutputStream(); 
			
			int data=-1;
			
			while(true) {
				data=fis.read();
				if(data==-1)break;
				//어디에 저장??
				os.write(data);
			}
		}
		
	}
}















