package com.hexagon.model1.dao;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import com.hexagon.model1.dto.Admin;
import com.hexagon.model1.pool.PoolManager;

/*이 클래스는 오직, admin 테이블에 대한 CRUD 만을 담당하는 DAO(Data Access Object) 이다!! */
public class AdminDAO {
	
	PoolManager pool=PoolManager.getInstance();
	
	//insert ~~~
	public int insert(Admin admin) {
		Connection con=null;
		PreparedStatement pstmt=null;
		int result=0;
		
		con=pool.getConnection(); //커넥션 한 개 빌려오기  
		
		String sql="insert into admin(user_id, password_hash, name, email) values(?,?,?,?)";
		
		try {
			pstmt = con.prepareStatement(sql);
			pstmt.setString(1, admin.getUserId());//DTO 에서 꺼내기
			pstmt.setString(2, admin.getPasswordHash());
			pstmt.setString(3, admin.getName());
			pstmt.setString(4, admin.getEmail());
			result = pstmt.executeUpdate(); //DML 이기 때문에...성공시 1반환, 실패 시 0 반환
		} catch (SQLException e) {
			e.printStackTrace();
		}finally {
			pool.release(con, pstmt);
		}
		return result;
	}
	
	
	//로그인 (아이디 및 패스워드가 모두 일치하는 지 여부..)
