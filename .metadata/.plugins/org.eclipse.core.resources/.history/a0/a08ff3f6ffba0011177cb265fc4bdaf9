package com.hexagon.galleryapp.controller.gallery;

import java.io.File;
import java.io.IOException;
import java.io.PrintWriter;

import javax.servlet.ServletException;
import javax.servlet.annotation.MultipartConfig;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.Part;

//겔러리의 글쓰기 요청을 처리하는 서블릿
@WebServlet("/gallery/regist")
//원래 파일업로드를 구현하려면, apache에서 제공하는 Fileupload 컴포넌트(라이브러리) 나 외부 라이브러리를 이용해야 했으나, 
//서블릿 3.0 부터는 자체적으로도 업로드 api를 지원함 
@MultipartConfig(
	fileSizeThreshold = 2*1024*1024, //임계값 지정, 파일의 용량이 지정된 값 이상일 경우 메모리가 아닌 임시 디렉토리에 저장
														//일반적으로 서버는 유저가 파일을 업로드하면 임시적으로 메모리에 보관하고난 후, 하드에 저장한다.
														//하지만, 유저가 업로드한 파일의 용량이 너무 클 경우 메모리가 낭비되어버리므로, 메모리대신 임시 디렉토리가 보관해놓고, 하드에 
														//에 확정적으로 저장한다..
	maxFileSize = 10*1024*1024, 		//유저가 업로드 시 파일 1개당 최대 크기 제한
	maxRequestSize =  50*1024*1024 //모든 업로드한 파일의 합산 최대 크기 제한 (업로드 한 파일의 수가 여러개 일 경우 그 합산 크기)
)
public class RegistServlet extends HttpServlet{
	
	//앞으로 이미지가 저장될 디렉토리!! 
	private final String UPLOAD_DIR="C:"+File.separator+"Users"+File.separator+"user"+File.separator+"upload";
	
	@Override
	protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		
		//클라이언트의 전송  encoding type 이  multipart/form-data 인 경우 그냥 request 객체로는 파라미터를 추출할 수 없고 반드시 
		//파일업로드 컴포넌트를 사용해야 하는데, 우리의 경우 @MultipartConfig 을 사용했기 때문에 파일 업로드 컴포넌트를 사용하지 않아도 파라미터를 추출할수있게 됨..
		
		//파라미터 받기 ( 한글 인코딩 처리는 이미 필터가 처리했음..) 
		String title			= request.getParameter("title");
		String writer		= request.getParameter("writer");
		String content	= request.getParameter("content");
		
		response.setContentType("text/html; charset=UTF-8");
		PrintWriter out	= response.getWriter();
		
		out.print(title+"<br>");
		out.print(writer+"<br>");
		out.print(content+"<br>");
		
		//일단 우리 os 에  upload 라는 디렉토리가 있는지 조사하고 만일 없다면 프로그래밍적으로 만들자!!
		File uploadDir=new File(UPLOAD_DIR);
		
		if(!uploadDir.exists()) {
			uploadDir.mkdirs(); //디렉토리 만들기!!
		}
		
		//생성 또는 존재하는 upload 디렉토리에, 업로드된 이미지파일의 데이터를 읽어서(input),  upload 에 내뱉자!!(output)
		Part filePart = request.getPart("photo");// 파일 파라미터 받기!!, 주의) String 이 아닌 바이너리 파일이다!! 
		
		// filePart 가 존재하고, 그 사이즈가 0보다 클때만 업로드 처리하자!! ( OS의 upload 디렉토리로 저장)
		if(filePart !=null && filePart.getSize() > 0) {
			//사용자가 업로드한 파일명을 알아맞추기..(헤더값에 실려서 날아온다)
			out.print(filePart.getHeader("content-disposition"));
			//사용자가 업로드한 파일명은  mysql table
			String[] disposition = filePart.getHeader("content-disposition").split(";");
			
			out.print(disposition);
			
			// 배열을 대상으로 반복문을 돌리면서 filename=  으로 시작하는 문자열만 사용하자 
			for(String str : disposition ) {
				if(str.trim().startsWith("filename")) { //  filename 앞에 공백문자가 포함되어 있으므로, 공백을 제거하자!!
					out.print(str);
					out.print("전체 문자열내에서 = 이 위치한  index는 "+str.indexOf("="));
					String filename=str.substring(str.indexOf("=")+1); //시작 index 만 명시하면 문자열의 끝까지를 의미함..
					out.print(filename);
				}
			}
			
		}
		
	}
			
}












