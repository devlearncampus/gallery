package com.hexagon.galleryapp.controller.gallery;

import java.io.File;
import java.io.IOException;
import java.io.PrintWriter;

import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import com.hexagon.galleryapp.dao.GalleryDAO;

//삭제 요청을 처리하는 서블릿
@WebServlet("/gallery/delete")
public class DeleteServlet extends HttpServlet{
	
	GalleryDAO galleryDAO=new GalleryDAO();
	
	protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		//  delete from gallery where gallery_id=넘겨받은pk
		long galleryId=Long.parseLong(request.getParameter("gid")); //pk
		String filename = request.getParameter("filename"); //기존 파일명 
		
		//이미지 삭제 
		File file = new File("C:"+File.separator+"Users"+File.separator+"user"+File.separator+"upload"+File.separator+filename);
		if(file.delete()) {//파일 삭제!!
			
			int result = galleryDAO.delete(galleryId);// DB 에서 삭제
			response.setContentType("text/html; charset=UTF-8");
			PrintWriter out = response.getWriter();
			
			out.print("<script>");
			if(result==1) { //성공
				out.print("alert('삭제 성공');");
				out.print("location.href='/gallery/list.jsp';");
			}else {//실패
				out.print("alert('삭제 실패');");
				out.print("history.back();");
			}
			out.print("</script>");
		} 
	}
}






