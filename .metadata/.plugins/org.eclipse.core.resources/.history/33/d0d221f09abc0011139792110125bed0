package com.hexagon.galleryapp.mybatis;

import java.io.IOException;
import java.io.InputStream;
import org.apache.ibatis.io.Resources;
import org.apache.ibatis.session.SqlSessionFactory;
import org.apache.ibatis.session.SqlSessionFactoryBuilder;

/*
 * mybatis의 설정 파일(mybatis-config.xml)을 읽기 위한 java class
 * */
public class MybatisConfig {
	
	/*
 	Mybatis 는 개발자가 직접 JDBC api 를 다루지 않고도 쿼리문에 집중할수 있도록 해주는 Database분야(Persistence 영역) 
	*/
	public MybatisConfig() {
		String resource = "com/hexagon/galleryapp/mybatis/mybatis-config.xml";
		try(InputStream inputStream = Resources.getResourceAsStream(resource)) {
			SqlSessionFactory sqlSessionFactory = new SqlSessionFactoryBuilder().build(inputStream);
		} catch (IOException e) {
			e.printStackTrace();
		} 	
		
	}
	
}












