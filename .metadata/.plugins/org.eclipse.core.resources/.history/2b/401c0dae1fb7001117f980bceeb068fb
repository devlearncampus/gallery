package com.hexagon.model1.util;

import java.util.HashMap;
import java.util.Iterator;
import java.util.Map;
import java.util.Set;

public class MapStudy {

	public static void main(String[] args) {
		/*
		 컬렉션 프레임웍의 3번째 유형인  Map에 대해 학습한다
		 객체를 모아서 처리하는 방법 중,  Map은 key-value 의 쌍으로 데이터를 관리한다...
		 
		 주의) map의  key 값은 중복을 허용하지 않는다, 하지만  value는 중복을 허용한다..
		*/
		
		//최상위 인터페이스이므로, 구현한 클래스를 사용해보자
		Map<String, String> map=new HashMap<String, String>();
		
		map.put("k1", "BMW");
		map.put("k2", "Benz");
		map.put("k3", "Audi");
		
		System.out.println(map.get("k2"));
		
		Set set = map.entrySet(); //key 만을 Set으로 모아놓은것..
		//개선된 포문을 사용할 수 있음..(주의 -  set에 들어있는 것은 오직 key 뿐이다)
		
		Iterator it = set.iterator(); // key 를 순서있게 나열...
		
		while(it.hasNext()) { //이터레이터 요소 수 만큼반복..
			it.next();
		}
		
	}

}










