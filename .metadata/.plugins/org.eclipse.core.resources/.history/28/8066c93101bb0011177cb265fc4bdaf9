package com.hexagon.galleryapp.util;

import javax.servlet.http.Part;

//개발자가 파일과 관련되어 재사용 가능성이 높은 코드들을 모아놓을 파일관련 유틸 클래스 
public class FileManager {
	
	// HTTP 헤더값으로부터 파일명만 추출해내는 메서드 정의 
	public String getFilenameFromHeader(Part filePart) {
		String result=null;
		
		String[] disposition = filePart.getHeader("content-disposition").split(";");
		System.out.print(disposition);	
		
		for(String str : disposition ) {
			if(str.trim().startsWith("filename")) { //  filename 앞에 공백문자가 포함되어 있으므로, 공백을 제거하자!!
				System.out.print(str+"<br>");
				System.out.print("전체 문자열내에서 = 이 위치한  index는 "+str.indexOf("=")+"<br>");
				String filename=str.substring(str.indexOf("=")+1); //시작 index 만 명시하면 문자열의 끝까지를 의미함..
				System.out.print(filename+"<br>");
				System.out.print(filename.replace("\"", ""));
				result = filename.replace("\"", "");
			}
		}
		
		return result;
	}
	
}
