<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 
실제 프로젝트 진행 시 수많은 테이블마다 1:1로 대응하도록 DTO, DAO, Mybatis Mapper xml도 만들게 된다..
이때 모든 Mybatis Mapper xml 마다 insert 라는 id를 중복해서 개발하면, 추후 java 언어가 이 xml 접근시 이름 중복으로 인하여
구분을 못하게될 수 있으므로, mapper의  namespace  속성을 이용하여 유일한 구분값으로 id들을 묶을 수 있다.. 
 -->  
<mapper namespace="com.hexagon.galleryapp.dto.Gallery">
	
	<!-- 
	 지금까지 JDBC  연동 시 사용해왔던 JDBC 관련 코드들은 쿼리문보다 주변의 상투적코드가 더 양이 많았다..(비효율적..)
	 따라서 Mybatis 를 이용하면 개발자가 JDBC의 상투적 코드를 작성하지 않고 오직 쿼리문에 집중할 수 있도록 도와준다..

	 주의) JDBC 기술이 사라진게 아니라, mybatis가 내부적으로  JDBC 코드를 대신 작성해는 원리임..
	 
	 Mybatis 와 같은 기술을 가리켜 SQL Mapper라 한다.. 
	 SQL Mapper란 SQL 문과 java의 클래스를 자동으로 매핑시켜주기 때문이다.. 
	 -->
	
	<!-- 게시물 한건 넣기 
		내부적으로 JDBC 를 사용하기 때문에 insert 에 사용되는 DTO를 이용하여 values값에 사용한다
		따라서 바인드 변수 인 #{중괄호}에 들어갈 값들은 DTO의 멤버변수를 적으면 된다
	-->
	<insert id="insert" parameterType="com.hexagon.galleryapp.dto.Gallery">
		insert into gallery(title, writer, content, original_name, filename) 
		values(#{title},  #{writer},#{content},#{originalName},#{filename}) 
	</insert>
	
	<!-- resultMap 은 다음과 같은 경우 사용됨
	1) 데이터베이스의 컬럼명과 java 객체의 멤버변수명이 일치하지 않을 경우 자동으로 매칭되지 않기 때문에, 개발자가 직접 resultMap에서 매칭을 시켜야 할 경우
	2) 조인을 위한 collection, associate 사용시.
	 -->
	<resultMap type="com.hexagon.galleryapp.dto.Gallery" id="galleryMap">
	
	</resultMap>
	
	<!-- 모든 게시물 가져오기  
		resultType 에 대해 자칫  List를 반환한다고 혼동하면 안된다..mybatis 에서의 resultType은 각 컬럼을 어느  DTO 에 담을지 그 자료형을 결정하는 것임
		만일 게시물의 수가 여러개 인 경우 자동으로  List가 반환됨..개발자가 별도의 명시는 하지 않는다!!
		
		아래와 같이 resultMap을 명시하면,  mybatis가 자동으로 매칭을 하는 것이 아니라, 개발자가 작성한  resultMap 태그에서 매핑이 발생함
	-->
	<select id="selectAll" resultMap="galleryMap">
		select gallery_id, title, writer, content, 
		original_name, filename, hit, created_at
		from gallery order by gallery_id desc
	</select>
	
	<!-- 레코드 한건 가져오기 -->
	
	<!-- 한건 수정하기 -->
	
	<!-- 한건 삭제하기 -->
		
</mapper>









