<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0">
	<display-name>model1</display-name>

	<!-- 서블릿이 요청을 처리하기 이전 시점에 모든 요청은 반드시, 필터를 거치게 된다. 따라서 개발자는 필터에 요청과 관련된 공통 
		기능이 있다면, 여기서 처리하게 되면, 코드 중복을 방지할 수 있다. 예) 파라미터를 받는 모든 서블릿마다 일일이 request.setCharacterEncoding("UTF-8") 
		사용자가 로그인 했는지 여부를 판단하는 로직 애플리케이션의 사용자 기록을 남기는 행위(로그 기록) -->

	<filter>
		<filter-name>encodingFilter</filter-name>
		<filter-class>com.hexagon.model1.filter.CharacterEncodingFilter</filter-class>
		
		<!-- 필터 클래스가 생성된 직후 초기화될때 사용할 파라미터 정의 -->
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>		
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>encodingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>


	<servlet>
		<servlet-name>registServlet</servlet-name>
		<servlet-class>com.hexagon.model1.controller.RegistServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>registServlet</servlet-name>
		<url-pattern>/board/regist</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>delServlet</servlet-name>
		<servlet-class>com.hexagon.model1.controller.DeleteServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>delServlet</servlet-name>
		<url-pattern>/board/delete</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>editServlet</servlet-name>
		<servlet-class>com.hexagon.model1.controller.UpdateServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>editServlet</servlet-name>
		<url-pattern>/board/update</url-pattern>
	</servlet-mapping>


</web-app>